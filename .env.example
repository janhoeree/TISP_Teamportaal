# Instellingen van het TISP Teamportaal (uitleg: docs/hosting.md).
# Op je eigen pc heb je dit bestand niet nodig. Wil je iets wijzigen: kopieer het naar .env.
# Een online host geeft deze waarden meestal mee als omgevingsvariabelen; dan is er geen .env nodig.

# Poort van de server.
PORT=8000

# 127.0.0.1 = alleen bereikbaar vanaf deze computer. Online: 0.0.0.0.
HOST=127.0.0.1

# Map waarin de gegevens bewaard worden. Leeg = de map gegevens/ naast server/.
GEGEVENS_MAP=
